# Roommate Chore Manager — Environment Variables Configuration Template
# Copy this file to .env.local and replace with your valid Firebase Web App credentials.

# 1. Firebase API Key (From Firebase Console -> Project Settings -> General -> Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourValidFirebaseApiKeyHere

# 2. Firebase Auth Domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=roommate-chore-manager.firebaseapp.com

# 3. Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=roommate-chore-manager

# 4. Firebase Storage Bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=roommate-chore-manager.appspot.com

# 5. Firebase Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012

# 6. Firebase App ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
